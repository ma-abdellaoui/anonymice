{
  "manifest_version": 3,
  "name": "anonymice",
  "version": "0.1.0",
  "description": "Finds sensitive data on native resources and shows you its whole footprint.",
  "minimum_chrome_version": "105",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "anonymice",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
