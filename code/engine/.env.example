# Development Configs
LITELLM_MASTER_KEY = "sk-1234"
DATABASE_URL = "postgresql://llmproxy:dbpassword9090@db:5432/litellm"
STORE_MODEL_IN_DB = "True"

# Anonymice PII layer
# Seals vault values at rest with AES-256-GCM. Without it, stored values are
# not encrypted. Generate one with: openssl rand -base64 32
LITELLM_PII_ENCRYPTION_KEY = ""

# Detection stages. Both are mandatory: without the NER service the rules stage
# covers only pattern entities, so names reach the provider in the clear and the
# guardrail refuses every request.
PRESIDIO_ANALYZER_API_BASE = "http://presidio:3000"
LITELLM_PII_NER_API_BASE = "http://piiranha:8080"

# Language passed to the rules analyzer. The bundled image registers en and de;
# asking for anything else fails the request rather than falling back.
LITELLM_PII_LANGUAGE = "en"

# Label vocabulary of the served NER model. Set it together with the model: a map
# that does not match drops every prediction and reports a clean scan.
# One of: piiranha, privacy_filter
LITELLM_PII_NER_LABEL_MAP = "piiranha"
